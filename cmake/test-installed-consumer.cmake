function(checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Consumer command failed (${result}): ${ARGV}\n${out}\n${err}")
  endif()
endfunction()
set(prefix "${CCELL_BUILD_DIR}/installed/prefix")
set(consumer "${CCELL_BUILD_DIR}/installed/consumer")
checked("${CMAKE_COMMAND}" --install "${CCELL_BUILD_DIR}" --prefix "${prefix}" --config "${CCELL_CONFIG}")
foreach(notice IN ITEMS LICENSE THIRD_PARTY_NOTICES.md)
  if(NOT EXISTS "${prefix}/share/licenses/ccell/${notice}")
    message(FATAL_ERROR "Missing installed ccell notice: ${notice}")
  endif()
endforeach()
if(EXISTS "${prefix}/lib/cmake/preprocess/preprocessConfig.cmake")
  message(FATAL_ERROR "Local preprocessing must not install a separate CONFIG package")
endif()
checked("${CMAKE_COMMAND}" -S "${CCELL_SOURCE_DIR}/tests/consumer" -B "${consumer}" -G Ninja
  "-DCMAKE_CXX_COMPILER=${CCELL_COMPILER}" "-DCMAKE_BUILD_TYPE=${CCELL_CONFIG}"
  "-DCMAKE_PREFIX_PATH=${prefix}")
checked("${CMAKE_COMMAND}" --build "${consumer}" --parallel 2)
checked("${consumer}/consumer_umbrella")
checked("${consumer}/consumer_components")
